# ============================================================================
# VIDYAVIKAS COACHING INSTITUTE WEBSITE & MANAGEMENT ERP - .env.example
# ============================================================================

# 1. Database Connection
# For PostgreSQL production deployment (use with prisma/schema.postgres.prisma):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vidyavikas_erp?schema=public"
# For local zero-config development:
DATABASE_URL="file:./dev.db"

# 2. Authentication & Security
JWT_SECRET="replace-with-at-least-32-char-cryptographic-secret"
SESSION_COOKIE_NAME="vv_erp_session"

# 3. Razorpay Payment Gateway (Server-Verified Orders & Webhooks)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# 4. Optional External Notification Providers (In-app notifications always enabled)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="notifications@yourinstitute.edu.in"
SMTP_PASS="your-app-password"
SMS_PROVIDER_API_KEY=""
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# 5. Public App Branding
NEXT_PUBLIC_INSTITUTE_NAME="VidyaVikas Academy of Excellence"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

